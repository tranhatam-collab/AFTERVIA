{
  "$id": "https://groundstead.iai.one/schema/card.schema.json",
  "description": "Layer S: safety card. Summary of official sources; shown directly in emergencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layer", "id", "locale", "version", "title", "hazard", "scope", "first_action", "avoid", "steps", "limits", "sources", "updated", "review"],
  "properties": {
    "layer": { "const": "S" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "locale": { "enum": ["en", "vi"] },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "hazard": {
      "enum": ["flood", "flash-flood", "landslide", "storm", "heat", "cold", "smoke", "power-outage", "earthquake", "tsunami", "water", "sanitation", "food", "first-aid", "communication", "go-bag", "home-stock", "evacuation"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["countries", "audience"],
      "properties": {
        "countries": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^([A-Z]{2}|GLOBAL)$" } },
        "audience": { "type": "array", "minItems": 1, "items": { "enum": ["adult", "child", "older", "disability", "pet", "organization"] } }
      }
    },
    "first_action": { "type": "string", "minLength": 5, "maxLength": 240 },
    "avoid": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "limits": { "type": "string", "minLength": 10 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "note": { "type": "string" } }
      }
    },
    "updated": { "type": "string", "format": "date" },
    "based_on": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "version"],
      "properties": { "locale": { "enum": ["en", "vi"] }, "version": { "type": "integer", "minimum": 1 } }
    },
    "review": { "$ref": "review.schema.json" }
  }
}
