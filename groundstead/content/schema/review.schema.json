{
  "$id": "https://groundstead.iai.one/schema/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": { "enum": ["AI_DRAFT", "COMMUNITY_CHECKED", "EXPERT_REVIEWED", "STALE"] },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "expertise": { "type": "string", "minLength": 2 }
      }
    },
    "reviewed_on": { "type": "string", "format": "date" },
    "stale_reason": { "type": "string", "minLength": 5 }
  }
}
