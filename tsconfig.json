{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@aftervia/domain": [
        "packages/domain/src/index.ts"
      ],
      "@aftervia/i18n": [
        "packages/i18n/src/index.ts"
      ]
    },
    "allowJs": true
  },
  "include": [
    "packages/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts",
    "tools/checks/*.mjs",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx",
    "apps/web/vite.config.ts",
    "vitest.config.ts"
  ]
}
