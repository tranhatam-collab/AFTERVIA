# Tên biến và mô tả, KHÔNG có giá trị thật. Không commit file .env.
# Local/test database (Postgres 16). Tên DB kiểm thử phải kết thúc bằng _test.
DATABASE_URL=
TEST_DATABASE_URL=
APP_ENV=local
# Nhà cung cấp AI: để disabled cho đến khi DEC06 (vendor/privacy) được chủ dự án duyệt.
AI_PROVIDER=disabled
# Webhook thanh toán sandbox (WO12). Không dùng khóa live khi chưa có phê duyệt DEC09.
BILLING_WEBHOOK_SECRET=
