# Tên biến và mô tả, KHÔNG có giá trị thật. Không commit file .env.
# Biến được đọc từ môi trường của shell hoặc cài đặt môi trường; tệp .env không được tự nạp.

# Cơ sở dữ liệu cục bộ (PostgreSQL 16). Tên DB kiểm thử phải kết thúc bằng _test.
DATABASE_URL=
TEST_DATABASE_URL=
APP_ENV=local

# Nhà cung cấp AI: để disabled cho đến khi DEC06 (vendor và privacy) được chủ dự án duyệt.
AI_PROVIDER=disabled

# Webhook thanh toán sandbox (WO12). Không dùng khóa live khi chưa có phê duyệt DEC09.
BILLING_WEBHOOK_SECRET=

# Khóa HawkScan DAST (DEC-ENG-09). Chỉ đặt trong cài đặt môi trường, không dán vào chat, không commit.
HAWK_API_KEY=

# Khóa ký JWT cho đăng nhập GIẢ LẬP ở môi trường local/test (DEC-ENG-11). Không dùng ở production.
AFTERVIA_LOCAL_JWT_SECRET=
