{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence reference (does not prove authenticity)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "sha256",
    "source_locator",
    "assertion_status",
    "confirmed_by",
    "confirmed_at"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_locator": {
      "type": "object",
      "required": [
        "page",
        "raw_text"
      ],
      "properties": {
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "raw_text": {
          "type": "string"
        },
        "bounding_box": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "assertion_status": {
      "enum": [
        "AI_PROPOSED",
        "USER_CONFIRMED",
        "MERCHANT_CONFIRMED",
        "DISPUTED"
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assertion_status": {
            "enum": [
              "USER_CONFIRMED",
              "MERCHANT_CONFIRMED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "confirmed_by": {
            "type": "string",
            "format": "uuid"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
