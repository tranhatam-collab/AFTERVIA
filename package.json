{
  "name": "aftervia",
  "version": "0.1.0",
  "private": true,
  "description": "AFTERVIA: nền tảng phối hợp hậu mãi có chứng cứ (tên làm việc, chưa clearance).",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:loop": "node --test tools/loop/backlog.test.mjs tools/loop/matrix.test.mjs",
    "check:bundle": "node tools/checks/bundle-verify.mjs",
    "check:secrets": "node tools/checks/secret-scan.mjs",
    "db:migrate": "node tools/db/migrate.mjs",
    "loop": "node tools/loop/backlog.mjs",
    "verify": "npm run check:bundle && npm run check:secrets && npm run typecheck && npm run test && npm run test:loop"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
